# Make endpoints
MAKE_FETCH_RECENT_JOBS_URL=https://example.make.com/fetch_recent_jobs
MAKE_BULK_SCORE_NEW_JOBS_URL=https://example.make.com/bulk_score_new_jobs
MAKE_QUERY_JOBS_URL=https://example.make.com/query_jobs
MAKE_GENERATE_JOB_OUTPUT_URL=https://example.make.com/generate_job_output
