{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["package_type", "audit_os_version", "orchestration_contract", "candidate_sha256", "admission_receipt_sha256", "independent_review_receipt_sha256", "audit_summary_sha256", "status"],
  "properties": {
    "package_type": {"const": "INDEPENDENT_AUDIT_OUTPUT"},
    "audit_os_version": {"const": "5.0.0"},
    "orchestration_contract": {"const": "v9"},
    "candidate_sha256": {"pattern": "^[a-f0-9]{64}$"},
    "admission_receipt_sha256": {"pattern": "^[a-f0-9]{64}$"},
    "independent_review_receipt_sha256": {"pattern": "^[a-f0-9]{64}$"},
    "audit_summary_sha256": {"pattern": "^[a-f0-9]{64}$"},
    "status": {"enum": ["MERGE_READY", "REPAIR_REQUIRED"]}
  }
}
