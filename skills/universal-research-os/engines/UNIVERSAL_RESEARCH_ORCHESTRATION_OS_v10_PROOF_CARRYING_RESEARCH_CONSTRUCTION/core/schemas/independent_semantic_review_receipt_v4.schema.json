  "properties": {
    "status": {
      "const": "PASS"
    },
    "auditor_role": {
      "const": "INDEPENDENT"
    },
    "independence_attestation": {
      "const": true
    },
    "audit_os_version": {
      "const": "4.0.0"
    },
    "all_retained_direct_support_reviewed": {
      "const": true
    },
    "open_p0": {
      "const": 0
    },
    "open_p1": {
      "const": 0
    },
    "topic_risk_review_total": {
      "type": "integer",
      "minimum": 0
    },
    "topic_risk_review_pass": {
      "type": "integer",
      "minimum": 0
    },
    "open_p2": {
      "const": 0
    }
  },
  "$id": "urn:universal-research-os:v4:independent-semantic-review-receipt",
  "title": "Independent Semantic Review Receipt v4"
}
