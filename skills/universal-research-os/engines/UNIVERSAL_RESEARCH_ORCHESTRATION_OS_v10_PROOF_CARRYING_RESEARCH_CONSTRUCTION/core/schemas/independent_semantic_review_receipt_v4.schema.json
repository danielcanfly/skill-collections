{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "status",
    "candidate_sha256",
    "auditor_id",
    "auditor_session_id",
    "auditor_role",
    "independence_attestation",
    "audit_os_version",
    "reviewed_at",
    "all_retained_direct_support_reviewed",
    "retained_direct_support_total",
    "retained_direct_support_pass",
    "open_p0",
    "open_p1",
    "open_p2",
    "artifacts",
    "source_review_total",
    "source_review_pass",
    "locator_review_total",
    "locator_review_pass",
    "topic_risk_review_total",
    "topic_risk_review_pass"
