{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["repair_id", "findings"],
  "properties": {
    "repair_id": {"type": "string", "minLength": 1},
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "finding_id", "failure_class", "population_selector",
          "closure_scope", "expected_population_count",
          "review_all_retained_direct_support", "population_command",
          "closure_command", "expected_exit_code", "required_evidence_paths"
        ],
        "properties": {
          "finding_id": {"type": "string", "minLength": 1},
          "failure_class": {"type": "string", "minLength": 1},
          "population_selector": {"type": "string", "minLength": 1},
          "closure_scope": {"const": "CLASS_WIDE"},
          "expected_population_count": {"type": "integer", "minimum": 0},
          "review_all_retained_direct_support": {"const": true},
          "population_command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "closure_command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "expected_exit_code": {"type": "integer"},
          "required_evidence_paths": {"type": "array", "items": {"type": "string"}},
          "affected_paths": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
