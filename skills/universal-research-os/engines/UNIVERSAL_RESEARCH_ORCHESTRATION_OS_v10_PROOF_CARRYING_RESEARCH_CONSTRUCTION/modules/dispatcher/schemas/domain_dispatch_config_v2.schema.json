{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pre-Audited Universal Domain Dispatch Configuration v2",
  "type": "object",
  "required": [
    "domain_id",
    "domain_title",
    "domain_title_en",
    "purpose",
    "audience",
    "languages",
    "global_exclusions",
    "children"
  ],
  "properties": {
    "domain_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "domain_title": {
      "type": "string",
      "minLength": 2
    },
    "domain_title_en": {
      "type": "string",
      "minLength": 2
    },
    "purpose": {
      "type": "string",
      "minLength": 40
    },
    "audience": {
      "type": "string",
      "minLength": 5
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "global_exclusions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "children": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/child"
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "candidate_id",
        "kind",
        "title",
        "definition_query",
        "decision_query",
        "failure_query",
        "negative_candidate_id"
      ],
      "properties": {
        "candidate_id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "concept",
            "pattern",
            "checklist",
            "source-note",
            "appendix"
          ]
        },
        "title": {
          "type": "string"
        },
        "definition_query": {
          "type": "string",
          "minLength": 20
        },
        "decision_query": {
          "type": "string",
          "minLength": 20
        },
        "failure_query": {
          "type": "string",
          "minLength": 20
        },
        "negative_candidate_id": {
          "type": "string"
        }
      }
    },
    "module": {
      "type": "object",
      "required": [
        "module_id",
        "title",
        "must_research",
        "must_compare",
        "expected_outputs",
        "source_families"
      ],
      "properties": {
        "module_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "must_research": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "must_compare": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "expected_outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "source_families": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "source_route": {
      "type": "object",
      "required": [
        "route_id",
        "authority_tier",
        "source_family",
        "target_examples",
        "why_required",
        "challenge_or_limit_query"
      ],
      "properties": {
        "route_id": {
          "type": "string"
        },
        "authority_tier": {
          "enum": [
            "primary-authoritative",
            "primary-empirical",
            "secondary-synthesis",
            "practitioner",
            "case-first-party",
            "critical-challenge"
          ]
        },
        "source_family": {
          "type": "string"
        },
        "target_examples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "why_required": {
          "type": "string"
        },
        "challenge_or_limit_query": {
          "type": "string"
        }
      }
    },
    "semantic_risk": {
      "type": "object",
      "required": [
        "risk_id",
        "risk",
        "affected_nodes",
        "preventive_control",
        "required_evidence"
      ],
      "properties": {
        "risk_id": {
          "type": "string"
        },
        "risk": {
          "type": "string"
        },
        "affected_nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "preventive_control": {
          "type": "string"
        },
        "required_evidence": {
          "type": "string"
        }
      }
    },
    "auditor_test": {
      "type": "object",
      "required": [
        "test_id",
        "class",
        "query",
        "expected_ids",
        "negative_ids"
      ],
      "properties": {
        "test_id": {
          "type": "string"
        },
        "class": {
          "enum": [
            "definition",
            "comparison",
            "how-to",
            "decision/application",
            "audit",
            "source-provenance",
            "multi-hop",
            "adversarial"
          ]
        },
        "query": {
          "type": "string",
          "minLength": 20
        },
        "expected_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "negative_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "source_authority_test": {
      "type": "object",
      "required": [
        "test_id",
        "query",
        "minimum_primary_sources"
      ],
      "properties": {
        "test_id": {
          "type": "string"
        },
        "query": {
          "type": "string",
          "minLength": 30
        },
        "minimum_primary_sources": {
          "type": "integer",
          "minimum": 2
        }
      }
    },
    "child": {
      "type": "object",
      "required": [
        "session_id",
        "slug",
        "title",
        "title_en",
        "mission",
        "candidate_version",
        "final_output_name",
        "namespace_prefixes",
        "canonical_ownership",
        "explicit_exclusions",
        "research_modules",
        "core_questions",
        "expected_nodes",
        "mandatory_source_routes",
        "debates",
        "case_types",
        "case_minimum",
        "semantic_risks",
        "auditor_holdout_tests",
        "source_authority_tests"
      ],
      "properties": {
        "session_id": {
          "type": "string"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "title": {
          "type": "string"
        },
        "title_en": {
          "type": "string"
        },
        "mission": {
          "type": "string",
          "minLength": 50
        },
        "candidate_version": {
          "type": "string",
          "pattern": "^v[1-9][0-9]*$"
        },
        "final_output_name": {
          "type": "string",
          "pattern": "PRODUCTION_CANDIDATE_v[1-9][0-9]*\\.zip$"
        },
        "namespace_prefixes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "canonical_ownership": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string"
          }
        },
        "explicit_exclusions": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        },
        "research_modules": {
          "type": "array",
          "minItems": 6,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/module"
          }
        },
        "core_questions": {
          "type": "array",
          "minItems": 8,
          "items": {
            "type": "string"
          }
        },
        "expected_nodes": {
          "type": "array",
          "minItems": 16,
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "mandatory_source_routes": {
          "type": "array",
          "minItems": 8,
          "items": {
            "$ref": "#/$defs/source_route"
          }
        },
        "debates": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "string"
          }
        },
        "case_types": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        },
        "case_minimum": {
          "type": "integer",
          "minimum": 6
        },
        "semantic_risks": {
          "type": "array",
          "minItems": 5,
          "items": {
            "$ref": "#/$defs/semantic_risk"
          }
        },
        "auditor_holdout_tests": {
          "type": "array",
          "minItems": 10,
          "items": {
            "$ref": "#/$defs/auditor_test"
          }
        },
        "source_authority_tests": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/source_authority_test"
          }
        }
      }
    }
  }
}
